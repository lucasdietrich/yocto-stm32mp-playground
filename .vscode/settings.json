{
    "search.exclude": {
        "build/**": true,
        "./build/conf/**": false,
    },
    "files.associations": {
        "*.inc": "bitbake",
        "*.conf": "bitbake"
    },
    "python.autoComplete.extraPaths": [
        "${workspaceFolder}/sources/poky/bitbake/lib",
        "${workspaceFolder}/sources/poky/meta/lib"
    ],
    "python.analysis.extraPaths": [
        "${workspaceFolder}/sources/poky/bitbake/lib",
        "${workspaceFolder}/sources/poky/meta/lib"
    ],
    "bitbake.parseOnSave": false,
}