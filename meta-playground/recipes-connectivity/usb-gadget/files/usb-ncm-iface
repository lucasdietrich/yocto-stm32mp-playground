#!/bin/sh
set -eu

IFACE="${INTERFACE:-${1:-usb0}}"

BOARD_IP="${BOARD_IP:-10.77.0.1}"
BOARD_CIDR="${BOARD_CIDR:-10.77.0.1/24}"

[ "$IFACE" = "usb0" ] || exit 0
[ -d "/sys/class/net/$IFACE" ] || exit 0

ip link set "$IFACE" up

if ! ip -4 addr show dev "$IFACE" | grep -q "${BOARD_IP}/24"; then
    ip -4 addr flush dev "$IFACE" || true
    ip addr add "$BOARD_CIDR" dev "$IFACE"
fi

# dnsmasq is assumed to already run.
# If dnsmasq uses bind-dynamic, this is usually enough.
# HUP asks it to reload/recheck interfaces without a full restart.
killall -HUP dnsmasq 2>/dev/null || true

exit 0