software =
{
    version = "0.1.0";
    hardware-compatibility: [ "1.0" ];

    /* todo @@MACHINE@@ */
    @@MACHINE@@ = {
        images: (
            {
                filename = "@@IMAGE_BASENAME@@-@@MACHINE@@.rootfs.ext4.zst";
                type = "raw";
                device = "/dev/swu/other-rootfs";
                compressed = "zstd";
                sha256 = "$swupdate_get_sha256(@@IMAGE_BASENAME@@-@@MACHINE@@.rootfs.ext4.zst)";
            },
            {
                filename = "tf-a-@@TFA_DEVICETREE@@.stm32";
                type = "raw";
                device = "/dev/disk/by-partlabel/fsbla1";
                sha256 = "$swupdate_get_sha256(tf-a-@@TFA_DEVICETREE@@.stm32)";
            },
            {
                filename = "fip-@@MACHINE@@.bin";
                type = "raw";
                device = "/dev/disk/by-partlabel/fip-a";
                sha256 = "$swupdate_get_sha256(fip-@@MACHINE@@.bin)";
            },
            {
                filename = "@@IMAGE_BASENAME@@-@@MACHINE@@-bootfs.vfat";
                type = "raw";
                device = "/dev/disk/by-partlabel/bootfs";
                sha256 = "$swupdate_get_sha256(@@IMAGE_BASENAME@@-@@MACHINE@@-bootfs.vfat)";
            }
        );
        scripts: (
            {
                filename = "update-script.sh";
                type = "shellscript";
            }
        );
    }
}