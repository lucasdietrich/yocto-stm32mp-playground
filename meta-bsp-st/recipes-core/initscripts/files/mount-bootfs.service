[Unit]
Description=Mount bootfs partition by partlabel
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/mount-bootfs/mount-bootfs start
ExecStop=/usr/lib/mount-bootfs/mount-bootfs stop

[Install]
WantedBy=sysinit.target
