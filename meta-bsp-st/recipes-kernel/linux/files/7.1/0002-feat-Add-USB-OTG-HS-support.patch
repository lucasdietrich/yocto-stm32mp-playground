From 2545b55fb388bdda00f61dd3e0fb3a649a318e69 Mon Sep 17 00:00:00 2001
From: Lucas Dietrich <lucas.dietrich.git@proton.me>
Date: Tue, 9 Jun 2026 18:48:02 +0200
Subject: [PATCH 2/2] feat: Add USB OTG HS support

---
 arch/arm/boot/dts/st/stm32mp157f-dk2-amy.dts | 14 +++-----------
 1 file changed, 3 insertions(+), 11 deletions(-)

diff --git a/arch/arm/boot/dts/st/stm32mp157f-dk2-amy.dts b/arch/arm/boot/dts/st/stm32mp157f-dk2-amy.dts
index cd839ccb2729..1576ea339f77 100644
--- a/arch/arm/boot/dts/st/stm32mp157f-dk2-amy.dts
+++ b/arch/arm/boot/dts/st/stm32mp157f-dk2-amy.dts
@@ -168,16 +168,8 @@ bluetooth {
 	};
 };
 
-/* Since I2C4 is disabled, STUSB1600 is also disabled so there is no Type-C support */
 &usbotg_hs {
-	dr_mode = "peripheral";
-	role-switch-default-mode = "peripheral";
-	/*
-	 * Forcing dr_mode = "peripheral"/"role-switch-default-mode = "peripheral";
-	 * will cause the pull-up on D+/D- to be raised as soon as the OTG is configured at runtime,
-	 * regardless of the presence of VBUS. Notice that on self-powered devices like
-	 * stm32mp157f-dk2, this isn't compliant with the USB standard. That's why usbotg_hs is kept
-	 * disabled here.
-	 */
-	status = "disabled";
+    dr_mode = "peripheral";
+    role-switch-default-mode = "peripheral";
+    status = "okay";
 };
-- 
