echo Boot script for @@MACHINE@@ from bootfs partition
setenv bootargs 'console=ttySTM0,115200 earlycon root=PARTLABEL=rootfs rootfstype=ext4 rw rootwait'
fatload mmc 0:${bootfs_part} ${kernel_addr_r} @@KERNEL_IMAGE@@
fatload mmc 0:${bootfs_part} ${fdt_addr_r} @@DTB_FILE@@
@@BOOT_CMD@@ ${kernel_addr_r} - ${fdt_addr_r}
