bootcmd_amy=
    echo Booting Amy board...;
    setenv bootdev 0;
    echo Looking for bootfs on mmc ${bootdev}...;
    echo TODO: use bootfs partition UUID instead of GPT partition name.;
    if part number mmc ${bootdev} bootfs bootfs_part; then
        echo bootfs partition found on mmc ${bootdev}:${bootfs_part};
        if fatload mmc ${bootdev}:${bootfs_part} ${scriptaddr} /boot.scr; then
            echo Running /boot.scr from mmc ${bootdev}:${bootfs_part}...;
            source ${scriptaddr};
        else
            echo No /boot.scr found in bootfs partition.;
        fi;
    else
        echo Unable to locate partition named bootfs on mmc ${bootdev}.;
    fi