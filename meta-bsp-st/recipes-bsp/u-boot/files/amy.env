bootcmd_amy=
    echo Booting Amy board...;
    echo TODO: use bootfs partition UUID instead of GPT partition name.;
    if part number mmc 0 bootfs bootfs_part; then
        echo bootfs partition found at index ${bootfs_part};
        if fatload mmc 0:${bootfs_part} ${scriptaddr} /boot.scr; then
            echo Running /boot.scr from bootfs partition...;
            source ${scriptaddr};
        else
            echo No /boot.scr found in bootfs partition.;
        fi;
    else
        echo Unable to locate partition named bootfs.;
    fi