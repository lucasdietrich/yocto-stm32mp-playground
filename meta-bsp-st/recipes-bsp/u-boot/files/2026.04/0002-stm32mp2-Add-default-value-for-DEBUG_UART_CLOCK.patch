From 34108b508496e8ff63fec713700457c95c95b91d Mon Sep 17 00:00:00 2001
From: Lucas Dietrich <lucas.dietrich.git@proton.me>
Date: Wed, 27 May 2026 19:45:02 +0200
Subject: [PATCH] stm32mp2: Add default value for DEBUG_UART_CLOCK

---
 arch/arm/mach-stm32mp/Kconfig.25x | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/arch/arm/mach-stm32mp/Kconfig.25x b/arch/arm/mach-stm32mp/Kconfig.25x
index 7d2d8171845..a296a2d9ed5 100644
--- a/arch/arm/mach-stm32mp/Kconfig.25x
+++ b/arch/arm/mach-stm32mp/Kconfig.25x
@@ -33,6 +33,9 @@ config DEBUG_UART_BOARD_INIT
 config DEBUG_UART_BASE
 	default 0x400e0000
 
+config DEBUG_UART_CLOCK
+	default 0
+
 endif
 
 source "board/st/stm32mp2/Kconfig"
