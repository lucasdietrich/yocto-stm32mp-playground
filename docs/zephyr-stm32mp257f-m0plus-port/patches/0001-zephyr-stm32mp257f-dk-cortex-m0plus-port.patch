diff --git a/dts/arm/st/mp2/stm32mp2_m0plus.dtsi b/dts/arm/st/mp2/stm32mp2_m0plus.dtsi
new file mode 100644
index 00000000000..11f20078619
--- /dev/null
+++ b/dts/arm/st/mp2/stm32mp2_m0plus.dtsi
@@ -0,0 +1,121 @@
+/*
+ * Copyright (C) 2025 Savoir-faire Linux, Inc.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <arm/armv6-m.dtsi>
+#include <freq.h>
+#include <mem.h>
+#include <zephyr/dt-bindings/gpio/gpio.h>
+#include <zephyr/dt-bindings/clock/stm32mp2_clock.h>
+#include <zephyr/dt-bindings/reset/stm32mp2_reset.h>
+
+/ {
+	cpus {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		cpu0: cpu@0 {
+			device_type = "cpu";
+			compatible = "arm,cortex-m0+";
+			reg = <0>;
+		};
+	};
+
+	/*
+	 * The Cortex-M0+ coprocessor can only access the LPSRAM1/2/3
+	 * memories (0x200c0000-0x200c7fff), loaded and started through
+	 * remoteproc by the Cortex-A35/Linux.
+	 */
+	lpsram_code: memory@200c0000 {
+		compatible = "zephyr,memory-region", "mmio-sram";
+		reg = <0x200c0000 DT_SIZE_K(16)>;
+		zephyr,memory-region = "LPSRAM_CODE";
+	};
+
+	lpsram_data: memory@200c4000 {
+		compatible = "zephyr,memory-region", "mmio-sram";
+		reg = <0x200c4000 DT_SIZE_K(8)>;
+		zephyr,memory-region = "LPSRAM_DATA";
+	};
+
+	lpsram_shm: memory@200c6000 {
+		compatible = "zephyr,memory-region", "mmio-sram";
+		reg = <0x200c6000 DT_SIZE_K(8)>;
+		zephyr,memory-region = "LPSRAM_SHM";
+	};
+
+	soc {
+		/*
+		 * The M0+ core has no RIF permission to access the real RCC
+		 * registers; peripherals it owns (e.g. LPUART1) are already
+		 * clocked by the A35 before this firmware starts. This node
+		 * (and its rctl child) is a no-op placeholder so the shared
+		 * uart_stm32.c driver, which unconditionally binds to the
+		 * devicetree node labeled "rcc", has something to attach to.
+		 */
+		rcc: rcc@44200000 {
+			compatible = "st,stm32mp2-rcc-m0stub";
+			#clock-cells = <2>;
+			reg = <0x44200000 DT_SIZE_K(64)>;
+
+			rctl: reset-controller {
+				compatible = "st,stm32-rcc-rctl-m0stub";
+				#reset-cells = <1>;
+			};
+		};
+
+		lpuart1: serial@46030000 {
+			compatible = "st,stm32-lpuart", "st,stm32-uart";
+			reg = <0x46030000 DT_SIZE_K(1)>;
+			clocks = <&rcc STM32_CLOCK(LPUART1, STM32_CLK)>;
+			resets = <&rctl STM32_RESET(LPUART1, STM32_RST)>;
+			interrupts = <11 0>;
+			status = "disabled";
+		};
+
+		/*
+		 * Only the two combined GPIO EXTI lines (0-7 and 8-15) are
+		 * routed to the Cortex-M0+ NVIC; the other EXTI2 lines are
+		 * not visible from this core.
+		 */
+		exti2: interrupt-controller@46230000 {
+			compatible = "st,stm32-exti";
+			interrupt-controller;
+			#interrupt-cells = <1>;
+			#address-cells = <0>;
+			reg = <0x46230000 DT_SIZE_K(1)>;
+			num-lines = <32>;
+			interrupts = <5 0>, <6 0>;
+			interrupt-names = "line0-7", "line8-15";
+			line-ranges = <0 8>, <8 8>;
+		};
+
+		/*
+		 * GPIOZ is physically a separate SmartRun-domain block, not
+		 * part of the main STM32MP2 pin-controller MMIO range (which
+		 * isn't reachable from M0+ at all) -- this wrapper only
+		 * exists so the vendor-generated pinctrl dtsi (which extends
+		 * "&pinctrl { ... }") has a node labeled "pinctrl" to attach
+		 * to.
+		 */
+		pinctrl: pin-controller@46200000 {
+			compatible = "st,stm32-pinctrl";
+			#address-cells = <1>;
+			#size-cells = <1>;
+			reg = <0x46200000 DT_SIZE_K(1)>;
+
+			gpioz: gpio@46200000 {
+				compatible = "st,stm32mp2-gpio";
+				gpio-controller;
+				#gpio-cells = <2>;
+				reg = <0x46200000 DT_SIZE_K(1)>;
+			};
+		};
+	};
+};
+
+&nvic {
+	arm,num-irq-priority-bits = <2>;
+};
diff --git a/dts/bindings/clock/st,stm32mp2-rcc-m0stub.yaml b/dts/bindings/clock/st,stm32mp2-rcc-m0stub.yaml
