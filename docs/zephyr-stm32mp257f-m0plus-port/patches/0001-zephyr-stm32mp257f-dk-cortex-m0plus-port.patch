index 00000000000..de42074d0b4
--- /dev/null
+++ b/boards/st/stm32mp257f_dk/support/openocd_stm32mp257f_dk_m0plus.cfg
@@ -0,0 +1,20 @@
+# Only enable the Cortex-M0+ debugger
+set EN_CA35_0 	0
+set EN_CA35_1 	0
+set EN_CM33   	0
+set EN_CM0P 	1
+
+source [find board/stm32mp25x_dk.cfg]
+
+# Set active target to Cortex-M0+
+targets stm32mp25x.m0p
+
+# Arm vector_catch on m0p as soon as it is examined, so the core halts at
+# the very first instruction after any reset (including a Linux-side
+# remoteproc "echo start") without a manual "monitor cortex_m vector_catch
+# reset". It's sticky, so this only needs to fire once. Disable for a
+# session with "monitor cortex_m vector_catch none".
+stm32mp25x.m0p configure -event examine-end {
+    cortex_m vector_catch reset
+    echo "m0p: vector_catch armed automatically (examine-end)"
+}
