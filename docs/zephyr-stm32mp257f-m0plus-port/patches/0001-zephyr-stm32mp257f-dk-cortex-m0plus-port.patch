diff --git a/soc/st/stm32/stm32mp2x/m0plus/rcc_stub.c b/soc/st/stm32/stm32mp2x/m0plus/rcc_stub.c
new file mode 100644
index 00000000000..59e13ab8f14
--- /dev/null
+++ b/soc/st/stm32/stm32mp2x/m0plus/rcc_stub.c
@@ -0,0 +1,64 @@
+/*
+ * Copyright (C) 2025 Savoir-faire Linux, Inc.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/*
+ * No-op clock-control driver for the M0+ core's "rcc" placeholder node.
+ * Real RCC access isn't possible from this core (see the compatible's
+ * devicetree binding); peripherals are already clocked by the A35 before
+ * this firmware starts, so on/off/get_status are pure formalities.
+ */
+
+#define DT_DRV_COMPAT st_stm32mp2_rcc_m0stub
+
+#include <zephyr/device.h>
+#include <zephyr/drivers/clock_control.h>
+
+static int rcc_m0stub_on_off(const struct device *dev, clock_control_subsys_t sys)
+{
+	ARG_UNUSED(dev);
+	ARG_UNUSED(sys);
+
+	return 0;
+}
+
+static enum clock_control_status rcc_m0stub_get_status(const struct device *dev,
+							 clock_control_subsys_t sys)
+{
+	ARG_UNUSED(dev);
+	ARG_UNUSED(sys);
+
+	return CLOCK_CONTROL_STATUS_ON;
+}
+
+/*
+ * ck_ker_lpuart1, as configured by the A35/Linux clock tree before this
+ * firmware starts (confirmed via `clk_summary` on target: 16 MHz). This is
+ * an independent clock mux, NOT tied to the M0+ core/HCLK frequency
+ * (CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC), since M0+ has no RCC access to
+ * read it back itself.
+ */
+#define LPUART1_KER_CLK_RATE 16000000
+
+static int rcc_m0stub_get_rate(const struct device *dev, clock_control_subsys_t sys,
+				uint32_t *rate)
+{
+	ARG_UNUSED(dev);
+	ARG_UNUSED(sys);
+
+	*rate = LPUART1_KER_CLK_RATE;
+
+	return 0;
+}
+
+static DEVICE_API(clock_control, rcc_m0stub_api) = {
+	.on = rcc_m0stub_on_off,
+	.off = rcc_m0stub_on_off,
+	.get_status = rcc_m0stub_get_status,
+	.get_rate = rcc_m0stub_get_rate,
+};
+
+DEVICE_DT_INST_DEFINE(0, NULL, NULL, NULL, NULL, PRE_KERNEL_1,
+		       CONFIG_CLOCK_CONTROL_INIT_PRIORITY, &rcc_m0stub_api);
diff --git a/soc/st/stm32/stm32mp2x/m0plus/reset_stub.c b/soc/st/stm32/stm32mp2x/m0plus/reset_stub.c
