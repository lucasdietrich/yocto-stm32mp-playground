@@ -0,0 +1,43 @@
+/*
+ * Copyright (C) 2025 Savoir-faire Linux, Inc.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/*
+ * No-op reset-controller driver for the M0+ core's "rctl" placeholder node.
+ * See rcc_stub.c / the compatible's devicetree binding for the rationale.
+ */
+
+#define DT_DRV_COMPAT st_stm32_rcc_rctl_m0stub
+
+#include <zephyr/device.h>
+#include <zephyr/drivers/reset.h>
+
+static int rctl_m0stub_status(const struct device *dev, uint32_t id, uint8_t *status)
+{
+	ARG_UNUSED(dev);
+	ARG_UNUSED(id);
+
+	*status = 0;
+
+	return 0;
+}
+
+static int rctl_m0stub_noop(const struct device *dev, uint32_t id)
+{
+	ARG_UNUSED(dev);
+	ARG_UNUSED(id);
+
+	return 0;
+}
+
+static DEVICE_API(reset, rctl_m0stub_api) = {
+	.status = rctl_m0stub_status,
+	.line_assert = rctl_m0stub_noop,
+	.line_deassert = rctl_m0stub_noop,
+	.line_toggle = rctl_m0stub_noop,
+};
+
+DEVICE_DT_INST_DEFINE(0, NULL, NULL, NULL, NULL, PRE_KERNEL_1,
+		       CONFIG_RESET_INIT_PRIORITY, &rctl_m0stub_api);
