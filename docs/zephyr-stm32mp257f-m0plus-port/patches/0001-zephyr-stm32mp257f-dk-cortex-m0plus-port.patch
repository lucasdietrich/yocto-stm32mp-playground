diff --git a/soc/st/stm32/stm32mp2x/m0plus/CMakeLists.txt b/soc/st/stm32/stm32mp2x/m0plus/CMakeLists.txt
new file mode 100644
index 00000000000..247bcae462e
--- /dev/null
+++ b/soc/st/stm32/stm32mp2x/m0plus/CMakeLists.txt
@@ -0,0 +1,24 @@
+# Copyright (C) 2025 Savoir-faire Linux, Inc.
+#
+# SPDX-License-Identifier: Apache-2.0
+
+zephyr_include_directories(${ZEPHYR_BASE}/drivers)
+zephyr_sources(
+  soc.c
+  rcc_stub.c
+  reset_stub.c
+)
+
+# The M0+ core's CMSIS device header (stm32mp257fxx_cm0.h) only defines
+# LPUART1 (no USART1..UART9), since those peripherals are not accessible
+# to this core. The vendor STM32Cube LL USART header
+# (stm32mp2xx_ll_usart.h) guards its entire content -- including the
+# generic inline register-access helpers used by the Zephyr UART driver
+# for LPUART -- behind `#if defined(USART1) || ... || defined(UART9)`.
+# Define a dummy USART1 alias to LPUART1 so that guard is satisfied and
+# the shared LL_USART_* helpers become visible for LPUART1 use.
+zephyr_compile_definitions(USART1=LPUART1)
+
+zephyr_include_directories(.)
+
+set(SOC_LINKER_SCRIPT ${CMAKE_CURRENT_SOURCE_DIR}/linker.ld CACHE INTERNAL "")
