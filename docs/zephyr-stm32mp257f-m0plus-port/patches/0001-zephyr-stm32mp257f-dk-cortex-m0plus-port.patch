--- /dev/null
+++ b/dts/bindings/clock/st,stm32mp2-rcc-m0stub.yaml
@@ -0,0 +1,27 @@
+# Copyright (C) 2025 Savoir-faire Linux, Inc.
+# SPDX-License-Identifier: Apache-2.0
+
+description: |
+  No-op clock-control node for the STM32MP2 Cortex-M0+ core.
+
+  The M0+ core has no RIF permission to access the real RCC registers;
+  clock gating for M0+-owned peripherals (e.g. LPUART1) is done by the
+  Cortex-A35 before the M0+ firmware is started via remoteproc. This node
+  only exists so drivers that unconditionally bind to the devicetree node
+  labeled "rcc" (e.g. STM32_CLOCK_CONTROL_NODE in uart_stm32.c) have a
+  device to attach to; the backing driver never touches hardware.
+
+compatible: "st,stm32mp2-rcc-m0stub"
+
+include: [clock-controller.yaml, base.yaml]
+
+properties:
+  reg:
+    required: true
+
+  "#clock-cells":
+    const: 2
+
+clock-cells:
+  - bus
+  - bits
