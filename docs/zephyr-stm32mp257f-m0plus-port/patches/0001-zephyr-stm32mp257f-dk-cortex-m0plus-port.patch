index 00000000000..6383f7c93a0
--- /dev/null
+++ b/boards/st/stm32mp257f_dk/stm32mp257f_dk_stm32mp257fxx_m0plus.dts
@@ -0,0 +1,46 @@
+/*
+ * Copyright (C) 2025 Savoir-faire Linux, Inc.
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+/dts-v1/;
+#include <st/mp2/stm32mp257_m0plus.dtsi>
+#include <st/mp2/stm32mp257faix-pinctrl.dtsi>
+
+/ {
+	model = "STMicroelectronics STM32MP257F-DK board";
+	compatible = "st,stm32mp257f-dk", "st,stm32mp25";
+
+	chosen {
+		zephyr,console = &lpuart1;
+		zephyr,shell-uart = &lpuart1;
+		zephyr,flash = &lpsram_code;
+		zephyr,sram = &lpsram_data;
+	};
+
+	/*
+	 * GPIOZ is the only GPIO bank reachable from the Cortex-M0+ core
+	 * (SmartRun domain). PZ0 is not wired to a board LED; used here as
+	 * a generic GPIO for the blinky sample.
+	 */
+	leds {
+		compatible = "gpio-leds";
+
+		blue_led_pz0: led_pz0 {
+			gpios = <&gpioz 0 GPIO_ACTIVE_HIGH>;
+			label = "PZ0";
+		};
+	};
+
+	aliases {
+		led0 = &blue_led_pz0;
+	};
+};
+
+&lpuart1 {
+	pinctrl-0 = <&lpuart1_tx_pz7 &lpuart1_rx_pz8>;
+	pinctrl-names = "default";
+	current-speed = <115200>;
+	status = "okay";
+};
